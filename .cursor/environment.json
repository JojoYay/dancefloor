{
  "name": "dancefloor (MiniCRM / WoodenTag)",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "app",
      "command": "export JAVA_HOME=\"$HOME/.jdks/zulu14\"; export PATH=\"$JAVA_HOME/bin:$PATH\"; ./mvnw -Dskip.installnodenpm=true -Dskip.npm=true spring-boot:run",
      "description": "Spring Boot dev server (WoodenTag/MiniCRM) on http://localhost:8080"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 8080
    }
  ]
}
